{
  "name": "jarvis-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && node scripts/desktop.mjs --built",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "desktop": "node scripts/desktop.mjs",
    "setup": "node scripts/setup.mjs",
    "qa:electron": "npm run build && node scripts/verify-desktop.cjs",
    "qa:voice": "npm run build && node scripts/verify-voice-runtime.cjs",
    "qa:wake": "npm run build && node scripts/verify-wake-runtime.cjs",
    "qa:overlay": "npm run build && node scripts/verify-overlay.cjs",
    "qa:watchers": "npm run build && node scripts/verify-watchers.cjs",
    "qa:workspace": "npm run build && node scripts/verify-workspace.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.46.0",
    "react": "19.2",
    "react-dom": "19.2"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "playwright": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
