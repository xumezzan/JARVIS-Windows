# Reference only: Jarvis reads process environment variables, not this file.
# Set these in your terminal before launching. All entries are non-secret.
# Never place passwords, API keys, cookies, or OAuth tokens here.
# Secrets belong in the OS credential store, not in .env files.
JARVIS_TASK_TIMEOUT_MS=10000
JARVIS_ACTIVITY_LIMIT=200
# Optional: JARVIS_DATA_DIR overrides the OS-specific local data directory.

# Strict Sandbox allowlist; ignored in Live Browser. Non-secret process settings only.
JARVIS_BROWSER_MODE=strict
# Live only, optional: http://localhost:9222 (Chrome must already have CDP enabled).
JARVIS_BROWSER_CDP_ENDPOINT=
# Exact HTTPS origins, comma-separated; empty value denies all Strict navigation.
JARVIS_BROWSER_ORIGINS=https://example.com,https://www.python.org,https://docs.python.org,https://html.duckduckgo.com

# Folders the assistant may read and write. Empty value denies all file access.
# Unset means the user's own Desktop, Documents, Downloads, Pictures, Music and Videos.
JARVIS_FILE_ROOTS=

# Optional non-secret Responses API model identifier; blank requires input in the planner UI.
JARVIS_PLANNER_MODEL=
# API key setup: python -m jarvis.security.credentials set (hidden terminal input).
# OPENAI_API_KEY is deliberately not read.

# Additional local project folders, as a JSON array of absolute paths (not model-editable).
# Desktop/Downloads/Documents and the separate Jarvis workspace are available by default.
# Windows example JSON: ["D:\\Projects"]
JARVIS_FS_PROJECT_ROOTS=[]

# Optional local Vosk model; ordinary startup never downloads models.
JARVIS_VOSK_MODEL=
# 1 enables RMS/Vosk endpointing after a held recording gesture; 0 preserves manual release.
JARVIS_VOICE_AUTO_STOP_ON_SILENCE=0
# Explicit opt-in to local background microphone waiting in Electron; Stop suspends it.
JARVIS_VOICE_WAKE_WORD=0
JARVIS_VOICE_RMS_THRESHOLD=500
# Optional: calibrate from the first two quiet 100 ms frames (3 x measured noise RMS).
JARVIS_VOICE_RMS_CALIBRATE=0
