# Reference only: Jarvis reads process environment variables, not this file.
# Set these in your terminal before launching. All entries are non-secret.
# Never place passwords, API keys, cookies, or OAuth tokens here.
# Future secrets belong in the OS credential store, not in .env files.
JARVIS_DEMO_DURATION_MS=2400
JARVIS_TASK_TIMEOUT_MS=10000
JARVIS_ACTIVITY_LIMIT=200
# Optional: JARVIS_DATA_DIR overrides the OS-specific local data directory.

# Exact HTTPS origins, comma-separated; empty value denies all browser navigation.
# Does not enable private networks, JavaScript, credentials, redirects, or POST.
JARVIS_BROWSER_ORIGINS=https://example.com,https://www.python.org,https://docs.python.org,https://html.duckduckgo.com
